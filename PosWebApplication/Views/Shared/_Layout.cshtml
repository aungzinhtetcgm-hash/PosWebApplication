@using PosWebApplication.Services
@inject SessionService SessionService

@{
    var currentUser = SessionService.GetUser();

    string profileImage = "/images/default_Image.jpg";

    if (currentUser != null &&
        !string.IsNullOrWhiteSpace(currentUser.img))
    {
        profileImage = $"/images/users/{currentUser.img}";
    }
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - PosWebApplication
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>


<body>

    <header>

        <nav class="navbar navbar-expand-lg navbar-light bg-light">

            <div class="container">

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    PosWebApplication

                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarContent"
                        aria-controls="navbarContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse"
                     id="navbarContent">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>

                        @if (currentUser != null)
                        {
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Post"
                                   asp-action="Index">

                                    Post

                                </a>

                            </li>
                        }

                    </ul>

                    <ul class="navbar-nav align-items-center">


                        @if (currentUser == null)
                        {
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="User"
                                   asp-action="Register">

                                    Register

                                </a>

                            </li>


                            <!-- Login -->

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="User"
                                   asp-action="Login">

                                    Login

                                </a>

                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">

                                <a asp-controller="User"
                                   asp-action="Profile"
                                   title="User Profile">

                                    <img src="@profileImage"
                                         alt="Profile"
                                         width="40"
                                         height="40"
                                         style="
                                    object-fit: cover;
                                    border-radius: 50%;
                                    cursor: pointer;
                                    " />

                                </a>

                            </li>

                            <li class="nav-item">

                                <span class="nav-link">

                                    @currentUser.name

                                </span>

                            </li>

                            <li class="nav-item">

                                <form asp-controller="User"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-link nav-link">

                                        Logout

                                    </button>

                                </form>

                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>

    <div class="container">

        <main role="main"
              class="pb-3">

            @RenderBody()

        </main>

    </div>


    <footer class="border-top footer text-muted">

        <div class="container">

            &copy; 2026 - PosWebApplication

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>