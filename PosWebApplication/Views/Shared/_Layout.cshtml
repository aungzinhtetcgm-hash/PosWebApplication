@using System.Security.Claims
@using PosWebApplication.Constraints

@{
    var isLoggedIn =
        User.Identity?.IsAuthenticated == true;

    var userName =
        User.FindFirst(ClaimTypes.Name)?.Value
        ?? "User";

    var profileImage =
        User.FindFirst("ProfileImage")?.Value;

    var profileImagePath =
        "/images/default_Image.jpg";

    if (!string.IsNullOrWhiteSpace(profileImage))
    {
        profileImagePath =
            $"/images/users/{profileImage}";
    }

    var isAdmin =
        User.IsInRole(
            UserRoles.Admin.ToString());
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - PosWebApplication
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body>

    <header>

        <nav class="navbar navbar-expand-lg navbar-light bg-light">

            <div class="container">

                <!-- Brand -->

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    PosWebApplication

                </a>


                <!-- Mobile Button -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarContent"
                        aria-controls="navbarContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- Navbar Content -->

                <div class="collapse navbar-collapse"
                     id="navbarContent">

                    <!-- Left Menu -->

                    <ul class="navbar-nav me-auto">

                        <!-- Home -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>


                        @if (isLoggedIn)
                        {
                            <!-- Posts -->

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Post"
                                   asp-action="Index">

                                    Posts

                                </a>

                            </li>

                        }


                        @if (isAdmin)
                        {
                            <!-- Admin -->

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Admin"
                                   asp-action="Dashboard">

                                    Admin Dashboard

                                </a>

                            </li>
                        }

                    </ul>


                    <!-- Right Menu -->

                    <ul class="navbar-nav align-items-center">

                        @if (!isLoggedIn)
                        {
                            <!-- Register -->

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="User"
                                   asp-action="Register">

                                    Register

                                </a>

                            </li>


                            <!-- Login -->

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="User"
                                   asp-action="Login">

                                    Login

                                </a>

                            </li>
                        }
                        else
                        {
                            <!-- Profile Image -->

                            <li class="nav-item me-2">

                                <a asp-controller="User"
                                   asp-action="Profile"
                                   title="User Profile">

                                    <img src="@profileImagePath"
                                         alt="Profile"
                                         width="40"
                                         height="40"
                                         class="rounded-circle"
                                         style="
                                    object-fit: cover;
                                    cursor: pointer;
                                    " />

                                </a>

                            </li>


                            <!-- User Name -->

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="User"
                                   asp-action="Profile">

                                    @userName

                                </a>

                            </li>


                            <!-- Logout -->

                            <li class="nav-item">

                                <form asp-controller="User"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-link nav-link">

                                        Logout

                                    </button>

                                </form>

                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <!-- Main Content -->

    <div class="container">

        <main role="main"
              class="pb-3">

            @RenderBody()

        </main>

    </div>


    <!-- Footer -->

    <footer class="border-top footer text-muted">

        <div class="container">

            &copy; 2026 - PosWebApplication

        </div>

    </footer>


    <!-- Scripts -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>