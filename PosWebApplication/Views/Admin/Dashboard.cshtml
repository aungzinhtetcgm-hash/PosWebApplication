@model PosWebApplication.ViewModels.Admin.AdminDashboardViewModel
@using PosWebApplication.Constraints

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                Admin Dashboard
            </h2>

            <p class="text-muted mb-0">
                Manage users and their roles
            </p>
        </div>

    </div>


    <!-- User List -->
    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h4 class="mb-0">
                    User List
                </h4>

                <span class="badge bg-primary">
                    @Model.Users.Count Users
                </span>

            </div>


            @if (Model.Users != null && Model.Users.Any())
            {
                <div class="table-responsive">

                    <table class="table table-bordered table-hover align-middle">

                        <thead class="table-light">

                            <tr>
                                <th>
                                    No.
                                </th>

                                <th>
                                    User ID
                                </th>

                                <th>
                                    Name
                                </th>

                                <th>
                                    Email
                                </th>

                                <th>
                                    Role
                                </th>

                                <th>
                                    Created Date
                                </th>

                                <th>
                                    Action
                                </th>
                            </tr>

                        </thead>


                        <tbody>

                            @for (int i = 0; i < Model.Users.Count; i++)
                            {
                                var user = Model.Users[i];

                                <tr>

                                    <!-- No -->
                                    <td>
                                        @(i + 1)
                                    </td>


                                    <!-- User ID -->
                                    <td>
                                        @user.u_id
                                    </td>


                                    <!-- Name -->
                                    <td>
                                        @user.name
                                    </td>


                                    <!-- Email -->
                                    <td>
                                        @user.email
                                    </td>


                                    <!-- Role -->
                                    <td>

                                        @if (user.role == UserRoles.Admin)
                                        {
                                            <span class="badge bg-success">
                                                Admin
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                User
                                            </span>
                                        }

                                    </td>


                                    <!-- Created Date -->
                                    <td>
                                        @user.created_at.ToString(
                                            "yyyy-MM-dd HH:mm")
                                    </td>


                                    <!-- Action -->
                                    <td>

                                        @if (user.role == UserRoles.Admin)
                                        {
                                            <span class="text-muted">
                                                No Action
                                            </span>
                                        }
                                        else
                                        {
                                            <!-- Make Admin -->
                                            <form asp-controller="Admin"
                                                  asp-action="MakeAdmin"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="userId"
                                                       value="@user.u_id" />

                                                <button type="submit"
                                                        class="btn btn-primary btn-sm">

                                                    Make Admin

                                                </button>

                                            </form>


                                            <!-- Delete User -->
                                            <form asp-controller="Admin"
                                                  asp-action="DeleteUser"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="userId"
                                                       value="@user.u_id" />

                                                <button type="submit"
                                                        class="btn btn-danger btn-sm"
                                                        onclick="return confirm('Are you sure you want to delete this user?');">

                                                    Delete

                                                </button>

                                            </form>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    No users found.
                </div>
            }

        </div>

    </div>

</div>