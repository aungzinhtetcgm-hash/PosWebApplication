@model List<PosWebApplication.ViewModels.Post.PublicPostViewModel>

@{
    ViewData["Title"] = "Home";
}

<div class="container mt-4">

    <h2 class="mb-4">
        Public Posts
    </h2>

    @if (Model.Any())
    {
        <div class="row">

            @foreach (var post in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start">

                                <h5 class="card-title">
                                    @post.title
                                </h5>

                                <span class="badge bg-success">
                                    Public
                                </span>

                            </div>

                            <p class="card-text text-muted">
                                @post.description
                            </p>

                            <small class="text-muted">
                                By @post.name
                            </small>

                            <br />

                            <small class="text-muted">
                                @post.created_at.ToString("yyyy-MM-dd HH:mm")
                            </small>

                            <div class="mt-3">
                                <a asp-controller="Post"
                                   asp-action="Details"
                                   asp-route-id="@post.p_id"
                                   class="btn btn-primary btn-sm">
                                    Details
                                </a>
                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="alert alert-info">
            No public posts available.
        </div>
    }

</div>