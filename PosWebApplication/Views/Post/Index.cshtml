@model PosWebApplication.ViewModels.Post.PostIndexViewModel

@{
    ViewData["Title"] = "My Posts";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2>My Posts</h2>

            <p class="text-muted mb-0">
                Manage your posts
            </p>

        </div>

        <a asp-controller="Post"
           asp-action="Create"
           class="btn btn-primary">

            + Create Post

        </a>

    </div>


    <h4 class="mb-3">
        My Public Posts
    </h4>


    @if (Model.PublicPosts.Any())
    {
        <div class="row">

            @foreach (var post in Model.PublicPosts)
            {
                <div class="col-md-6 col-lg-4 mb-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start mb-2">

                                <h5 class="card-title mb-0">
                                    @post.title
                                </h5>

                                <span class="badge bg-success">
                                    Public
                                </span>

                            </div>


                            <p class="card-text text-muted">
                                @post.description
                            </p>


                            <small class="text-muted">
                                By @post.name
                            </small>

                            <br />

                            <small class="text-muted">
                                @post.created_at.ToString("yyyy-MM-dd HH:mm")
                            </small>

                            <div class="mt-3">

                                <a asp-controller="Post"
                                   asp-action="Edit"
                                   asp-route-id="@post.p_id"
                                   class="btn btn-sm btn-warning">

                                    Edit

                                </a>


                                <form asp-controller="Post"
                                      asp-action="Delete"
                                      asp-route-id="@post.p_id"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-danger"
                                            onclick="return confirm('Are you sure you want to delete this post?');">

                                        Delete

                                    </button>

                                </form>

                            </div>
                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="alert alert-info">
            You don't have any public posts yet.
        </div>
    }

    <h4 class="mb-3 mt-5">
        My Private Posts
    </h4>


    @if (Model.PrivatePosts.Any())
    {
        <div class="row">

            @foreach (var post in Model.PrivatePosts)
            {
                <div class="col-md-6 col-lg-4 mb-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start mb-2">

                                <h5 class="card-title mb-0">
                                    @post.title
                                </h5>

                                <span class="badge bg-secondary">
                                    Private
                                </span>

                            </div>


                            <p class="card-text text-muted">
                                @post.description
                            </p>

                        </div>


                        <div class="card-footer bg-white">

                            <small class="text-muted">
                                Created:
                                @post.created_at.ToString("yyyy-MM-dd HH:mm")
                            </small>

                            <br />

                            <small class="text-muted">
                                Updated:
                                @post.updated_at.ToString("yyyy-MM-dd HH:mm")
                            </small>


                            <div class="mt-3">

                                <a asp-controller="Post"
                                   asp-action="Edit"
                                   asp-route-id="@post.p_id"
                                   class="btn btn-sm btn-warning">

                                    Edit

                                </a>


                                <form asp-controller="Post"
                                      asp-action="Delete"
                                      asp-route-id="@post.p_id"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-danger"
                                            onclick="return confirm('Are you sure you want to delete this post?');">

                                        Delete

                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="alert alert-info">
            You don't have any private posts yet.
        </div>
    }

</div>